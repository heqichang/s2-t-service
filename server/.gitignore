import { PrismaClient } from '@prisma/client';
import bcrypt from 'bcryptjs';

const prisma = new PrismaClient();

async function main() {
  console.log('开始初始化测试数据...');

  const teams = await Promise.all([
    prisma.team.upsert({
      where: { name: '技术支持组' },
      update: {},
      create: { name: '技术支持组', description: '处理技术类问题' },
    }),
    prisma.team.upsert({
      where: { name: '售前咨询组' },
      update: {},
      create: { name: '售前咨询组', description: '处理售前咨询类问题' },
    }),
    prisma.team.upsert({
      where: { name: '投诉处理组' },
      update: {},
      create: { name: '投诉处理组', description: '处理投诉建议类问题' },
    }),
  ]);

  const hashedPassword = await bcrypt.hash('123456', 10);

  const admin = await prisma.user.upsert({
    where: { email: 'admin@example.com' },
    update: {},
    create: {
      email: 'admin@example.com',
      password: hashedPassword,
      name: '系统管理员',
      role: 'ADMIN',
    },
  });

  const customers = await Promise.all([
    prisma.user.upsert({
      where: { email: 'customer1@example.com' },
      update: {},
      create: {
        email: 'customer1@example.com',
        password: hashedPassword,
        name: '张三',
        phone: '13800138001',
        role: 'CUSTOMER',
      },
    }),
    prisma.user.upsert({
      where: { email: 'customer2@example.com' },
      update: {},
      create: {
        email: 'customer2@example.com',
        password: hashedPassword,
        name: '李四',
        phone: '13800138002',
        role: 'CUSTOMER',
      },
    }),
    prisma.user.upsert({
      where: { email: 'customer3@example.com' },
      update: {},
      create: {
        email: 'customer3@example.com',
        password: hashedPassword,
        name: '王五',
        phone: '13800138003',
        role: 'CUSTOMER',
      },
    }),
  ]);

  const agentUsers = await Promise.all([
    prisma.user.upsert({
      where: { email: 'agent1@example.com' },
      update: {},
      create: {
        email: 'agent1@example.com',
        password: hashedPassword,
        name: '客服小王',
        role: 'AGENT',
      },
    }),
    prisma.user.upsert({
      where: { email: 'agent2@example.com' },
      update: {},
      create: {
        email: 'agent2@example.com',
        password: hashedPassword,
        name: '客服小李',
        role: 'AGENT',
      },
    }),
    prisma.user.upsert({
      where: { email: 'agent3@example.com' },
      update: {},
      create: {
        email: 'agent3@example.com',
        password: hashedPassword,
        name: '客服小赵',
        role: 'AGENT',
      },
    }),
  ]);

  await Promise.all([
    prisma.agent.upsert({
      where: { userId: agentUsers[0].id },
      update: { status: 'ONLINE' },
      create: { userId: agentUsers[0].id, teamId: teams[0].id, status: 'ONLINE' },
    }),
    prisma.agent.upsert({
      where: { userId: agentUsers[1].id },
      update: { status: 'ONLINE' },
      create: { userId: agentUsers[1].id, teamId: teams[1].id, status: 'ONLINE' },
    }),
    prisma.agent.upsert({
      where: { userId: agentUsers[2].id },
      update: { status: 'BUSY' },
      create: { userId: agentUsers[2].id, teamId: teams[2].id, status: 'BUSY' },
    }),
    prisma.agent.upsert({
      where: { userId: admin.id },
      update: {},
      create: { userId: admin.id, status: 'ONLINE' },
    }),
  ]);

  await Promise.all([
    prisma.tag.upsert({ where: { name: 'Bug' }, update: {}, create: { name: 'Bug', color: '#f5222d' } }),
    prisma.tag.upsert({ where: { name: '功能需求' }, update: {}, create: { name: '功能需求', color: '#1890ff' } }),
    prisma.tag.upsert({ where: { name: '使用疑问' }, update: {}, create: { name: '使用疑问', color: '#52c41a' } }),
    prisma.tag.upsert({ where: { name: '紧急' }, update: {}, create: { name: '紧急', color: '#faad14' } }),
  ]);

  const agents = await prisma.agent.findMany();

  const ticketData = [
    {
      title: '系统登录时提示账号密码错误',
      description: '我在登录系统时，输入正确的账号密码，系统总是提示错误，请帮忙查看。',
      category: 'TECHNICAL' as const,
      priority: 'HIGH' as const,
      status: 'PROCESSING' as const,
      customerId: customers[0].id,
      agentId: agents[0].id,
      tags: [1],
    },
    {
      title: '咨询企业版价格和功能对比',
      description: '想了解一下企业版的价格以及和个人版的功能对比，谢谢。',
      category: 'PRE_SALES' as const,
      priority: 'LOW' as const,
      status: 'PENDING' as const,
      customerId: customers[1].id,
      agentId: agents[1].id,
      tags: [2],
    },
    {
      title: '对服务态度投诉',
      description: '上次沟通中客服态度不好，希望改进。',
      category: 'COMPLAINT' as const,
      priority: 'MEDIUM' as const,
      status: 'WAITING_CUSTOMER' as const,
      customerId: customers[2].id,
      agentId: agents[2].id,
      tags: [4],
    },
    {
      title: '数据导出功能异常',
      description: '导出 Excel 文件打不开，显示格式有问题。',
      category: 'TECHNICAL' as const,
      priority: 'URGENT' as const,
      status: 'RESOLVED' as const,
      customerId: customers[0].id,
      agentId: agents[0].id,
      tags: [1, 4],
    },
  ];

  for (const td of ticketData) {
    const ticket = await prisma.ticket.create({
      data: {
        title: td.title,
        description: td.description,
        category: td.category,
        priority: td.priority,
        status: td.status,
        customerId: td.customerId,
        agentId: td.agentId,
        resolvedAt: td.status === 'RESOLVED' ? new Date() : null,
        tags: { create: td.tags.map((tagId) => ({ tagId })) },
    });

    await prisma.message.create({
      data: { ticketId: ticket.id, content: td.description, type: 'TEXT', userId: td.customerId,
      },
    });

    if (td.status !== 'PENDING') {
      await prisma.message.create({
        data: {
          ticketId: ticket.id,
          content: '您好，我们已经收到您的问题，正在处理中。',
          type: 'TEXT',
          agentId: td.agentId,
        },
      });
    }
  }

  console.log('测试数据初始化完成！');
  console.log('测试账号：');
  console.log('  管理员: admin@example.com / 123456');
  console.log('  客服: agent1@example.com / 123456');
  console.log('  客户: customer1@example.com / 123456');
}

main()
  .catch((e) => {
    console.error(e);
    process.exit(1);
  })
  .finally(async () => {
    await prisma.$disconnect();
  });
